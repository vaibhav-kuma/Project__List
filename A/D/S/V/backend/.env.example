# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ninor_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@ninor.com
SMTP_PASS=your-email-password
EMAIL_FROM=noreply@ninor.com

# Moderator/Admin Access (comma-separated emails)
MODERATOR_EMAILS=mod1@ninor.com,mod2@ninor.com
ADMIN_EMAILS=admin@ninor.com

# ML Moderation Models (optional - fallback models used if not provided)
ML_MODEL_PATH_NUDITY=./models/nudity
ML_MODEL_PATH_VIOLENCE=./models/violence
ML_MODEL_PATH_AGE_ESTIMATION=./models/age-estimation

# ML Moderation Thresholds (0.0 - 1.0)
ML_NUDITY_THRESHOLD=0.85
ML_VIOLENCE_THRESHOLD=0.80
ML_EXPLICIT_THRESHOLD=0.90
ML_SUGGESTIVE_THRESHOLD=0.75
ML_TERMINATE_THRESHOLD=0.95
ML_WARN_THRESHOLD=0.70

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=20

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Cloudinary (for image/video uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PLUS_MONTHLY_PRICE_ID=price_plus_monthly_id
STRIPE_PLUS_YEARLY_PRICE_ID=price_plus_yearly_id
STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly_id
STRIPE_PRO_YEARLY_PRICE_ID=price_pro_yearly_id

# Frontend
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Admin
ADMIN_EMAILS=admin@ninor.com
MODERATOR_EMAILS=mod@ninor.com

# JWT Refresh
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-in-production

# Session & Encryption
SESSION_SECRET=your-session-secret
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# CORS
CORS_ORIGIN=http://localhost:3000

# Database Pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# ML Moderation API (external provider)
ML_MODERATION_API_KEY=
ML_MODERATION_API_URL=

# AWS S3 (for media uploads fallback)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=ninor-media
CDN_URL=

# ID Verification Provider
ID_VERIFICATION_PROVIDER=manual

# Video Provider
VIDEO_PROVIDER=webrtc
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_HOST=

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_ENVIRONMENT=development

# Redis Prefix
REDIS_PREFIX=ninor

# Log Format
LOG_FORMAT=combined

# Stripe Premium (legacy plan IDs)
STRIPE_PREMIUM_PRICE_ID=price_premium_monthly
STRIPE_PREMIUM_YEARLY_PRICE_ID=price_premium_yearly
