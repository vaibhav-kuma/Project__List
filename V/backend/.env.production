# ── Ninor Production Environment Variables ───────────
# Copy to .env and fill in all values

NODE_ENV=production
PORT=3001

# Database
DATABASE_URL=postgresql://ninor:CHANGEME@ninor-db.cluster-xxxxx.us-east-1.rds.amazonaws.com:5432/ninor
DB_POOL_MIN=2
DB_POOL_MAX=20

# Redis
REDIS_URL=redis://CHANGEME@ninor-redis.xxxxx.ng.0001.use1.cache.amazonaws.com:6379

# JWT
JWT_SECRET=CHANGEME
JWT_REFRESH_SECRET=CHANGEME
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
SESSION_SECRET=CHANGEME
ENCRYPTION_KEY=CHANGEME

# URLs
FRONTEND_URL=https://ninor.app
CORS_ORIGIN=https://ninor.app

# SMTP
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=CHANGEME
SMTP_PASS=CHANGEME
SMTP_FROM=noreply@ninor.app

# Media
CLOUDINARY_CLOUD_NAME=CHANGEME
CLOUDINARY_API_KEY=CHANGEME
CLOUDINARY_API_SECRET=CHANGEME
S3_MEDIA_BUCKET=ninor-production-media
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGEME
AWS_SECRET_ACCESS_KEY=CHANGEME

# Video (LiveKit / Daily / Twilio)
VIDEO_PROVIDER=livekit
LIVEKIT_API_KEY=CHANGEME
LIVEKIT_API_SECRET=CHANGEME
LIVEKIT_HOST=https://ninor.livekit.cloud

# Payments
STRIPE_SECRET_KEY=sk_live_CHANGEME
STRIPE_WEBHOOK_SECRET=whsec_CHANGEME
STRIPE_PREMIUM_PRICE_ID=price_CHANGEME
STRIPE_PREMIUM_YEARLY_PRICE_ID=price_CHANGEME

# Moderation
ML_MODERATION_API_KEY=CHANGEME
ML_MODERATION_API_URL=https://api.moderation.example.com
TENSORFLOW_LOGGING=false

# Monitoring
SENTRY_DSN=https://CHANGEME@sentry.io/CHANGEME
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2

# Admin
ADMIN_EMAILS=admin@ninor.app
MODERATOR_EMAILS=mod@ninor.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Redis Prefix
REDIS_PREFIX=ninor:prod:
