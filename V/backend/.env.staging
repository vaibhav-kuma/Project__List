# ── Ninor Staging Environment Variables ─────────────
# Copy to .env and fill in all values

NODE_ENV=staging
PORT=3001

DATABASE_URL=postgresql://ninor:CHANGEME@staging-db.cluster-xxxxx.us-east-1.rds.amazonaws.com:5432/ninor_staging
REDIS_URL=redis://CHANGEME@staging-redis.xxxxx.ng.0001.use1.cache.amazonaws.com:6379

JWT_SECRET=CHANGEME
JWT_REFRESH_SECRET=CHANGEME
JWT_EXPIRY=30m
JWT_REFRESH_EXPIRY=30d
SESSION_SECRET=CHANGEME
ENCRYPTION_KEY=CHANGEME

FRONTEND_URL=https://staging.ninor.app
CORS_ORIGIN=https://staging.ninor.app

SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=CHANGEME
SMTP_PASS=CHANGEME
SMTP_FROM=noreply@ninor.app

CLOUDINARY_CLOUD_NAME=CHANGEME
CLOUDINARY_API_KEY=CHANGEME
CLOUDINARY_API_SECRET=CHANGEME

STRIPE_SECRET_KEY=sk_test_CHANGEME
STRIPE_WEBHOOK_SECRET=whsec_CHANGEME
STRIPE_PREMIUM_PRICE_ID=price_CHANGEME
STRIPE_PREMIUM_YEARLY_PRICE_ID=price_CHANGEME

ML_MODERATION_API_KEY=CHANGEME
ML_MODERATION_API_URL=https://api.moderation.example.com

SENTRY_DSN=https://CHANGEME@sentry.io/CHANGEME
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=1.0

ADMIN_EMAILS=admin@ninor.app
MODERATOR_EMAILS=mod@ninor.app

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200
LOG_LEVEL=debug
LOG_FORMAT=json
REDIS_PREFIX=ninor:staging:
