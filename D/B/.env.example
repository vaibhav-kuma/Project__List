## Shared
NODE_ENV=development

## API
API_PORT=4000
DATABASE_URL=file:./dev.db
# Optional (if you later run Redis). If unset, API uses in-memory queues.
REDIS_URL=
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=change_me_access_secret_32_chars_min
JWT_REFRESH_SECRET=change_me_refresh_secret_32_chars_min
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:4000/auth/oauth/google/callback

## Web
NEXT_PUBLIC_API_BASE=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

