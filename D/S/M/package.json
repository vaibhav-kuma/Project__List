{
  "name": "dealscout",
  "version": "1.0.0",
  "description": "Autonomous E-commerce Intelligence Agent - Hackathon Winner",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "worker": "node src/worker.js",
    "build": "cd frontend && npm run build",
    "test": "jest",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "setup": "npm install && cd frontend && npm install && cd .. && npm run docker:up"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "bull": "^4.11.3",
    "redis": "^4.6.7",
    "pg": "^8.11.1",
    "winston": "^3.10.0",
    "axios": "^1.4.0",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.8.1",
    "joi": "^17.9.2",
    "prom-client": "^14.2.0",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.0",
    "sharp": "^0.32.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}