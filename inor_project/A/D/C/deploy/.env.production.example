# ——————————————————————————————————————————
# Production Environment Variables — COPY TO .env
# ——————————————————————————————————————————

# ── Domain ──────────────────────────────────
DOMAIN=ytclone.example.com           # ← CHANGE to your domain

# ── Database ────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/youtube_clone?schema=public"

# ── Redis ───────────────────────────────────
REDIS_URL="redis://redis:6379"

# ── JWT Auth ────────────────────────────────
JWT_SECRET="change-this-to-a-random-secret-64-chars-long"
JWT_REFRESH_SECRET="change-this-to-another-random-secret-64-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── NextAuth ────────────────────────────────
NEXTAUTH_SECRET="change-this-to-a-different-random-secret"
NEXTAUTH_URL="https://${DOMAIN}"

# ── OAuth ───────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── AWS S3 (or MinIO) ───────────────────────
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="youtube-clone-videos"
# For MinIO inside Docker network:
AWS_S3_ENDPOINT="http://minio:9000"

# ── Meilisearch ─────────────────────────────
MEILISEARCH_URL="http://meilisearch:7700"
MEILISEARCH_API_KEY="master-key-change-in-production"

# ── RTMP (live streaming) ───────────────────
RTMP_URL="rtmp://localhost:1935/live"

# ── SMTP ────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ── Sentry ──────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ── Feature Flags ───────────────────────────
NEXT_PUBLIC_ENABLE_SHORTS="true"
NEXT_PUBLIC_ENABLE_LIVE="true"
