APP_NAME="SecureScout Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=securescout_pro
DB_USERNAME=securescout
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@securescout.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Filament Configuration
FILAMENT_FILESYSTEM_DISK=s3
FILAMENT_FILESYSTEM_DIRECTORY=uploads

# Security & Authentication
SANCTUM_STATEFUL_DOMAINS=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Two-Factor Authentication
GOOGLE2FA_SECRET=
GOOGLE2FA_QR_CODE_URL=https://chart.googleapis.com/chart?chs=200x200&chld=M|0&cht=qr&chl=

# WebAuthn
WEBAUTHN_USER_VERIFICATION=required
WEBAUTHN_USER_PRESENTATION=required
WEBAUTHN_TIMEOUT=60000

# Onfido Verification
ONFIDO_API_TOKEN=
ONFIDO_API_URL=https://api.onfido.com/v3.4

# Checkr Background Check
CHECKR_API_KEY=
CHECKR_API_URL=https://api.checkr.com/v1

# External APIs
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# Threat Intelligence
MISP_URL=
MISP_API_KEY=
VIRUSTOTAL_API_KEY=
ALIENVAULT_OTX_KEY=

# Social Media APIs
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="SecureScout Pro/1.0"

# GitHub Integration
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Bug Bounty Platforms
HACKERONE_CLIENT_ID=
HACKERONE_CLIENT_SECRET=
BUGCROWD_CLIENT_ID=
BUGCROWD_CLIENT_SECRET=

# SIEM Integration
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=
QRADAR_API_URL=
QRADAR_API_TOKEN=
SENTINEL_WORKSPACE_ID=
SENTINEL_SHARED_KEY=

# Communication Integrations
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
PAGERDUTY_API_KEY=

# Ticketing Systems
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=
SERVICENOW_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# Monitoring & Observability
PROMETHEUS_URL=
GRAFANA_URL=
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Legal & Compliance
LEGAL_EMAIL=legal@securescout.com
ABUSE_EMAIL=abuse@securescout.com
PRIVACY_EMAIL=privacy@securescout.com

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000
RATE_LIMIT_DOMAINS_PER_DAY=100

# Evidence Storage
EVIDENCE_DISK=s3
EVIDENCE_BUCKET=securescout-evidence
EVIDENCE_ENCRYPTION_KEY=

# Report Generation
REPORT_DISK=s3
REPORT_BUCKET=securescout-reports

# Backup Configuration
BACKUP_DISK=s3
BACKUP_BUCKET=securescout-backups

# SSL Certificate Verification
VERIFY_SSL_CERTIFICATES=true

# Development
TELESCOPE_ENABLED=false
HORIZON_ENABLED=false

# Legal Disclaimer (Must be displayed prominently)
LEGAL_DISCLAIMER_ENABLED=true
AUTHORIZATION_REQUIRED=true
DOMAIN_VERIFICATION_REQUIRED=true
